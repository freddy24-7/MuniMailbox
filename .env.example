# Copy to .env and fill in. .env is never committed (GR-10).

# local | test | production
ENVIRONMENT=local

# PostgreSQL container (deploy/docker-compose.yml)
POSTGRES_USER=munimailbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=munimailbox
POSTGRES_PORT=5432

# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://munimailbox:change-me@localhost:5432/munimailbox

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (shipped to Loki) | console (readable during development)
LOG_FORMAT=json
