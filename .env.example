# Copy to .env and fill in. .env is never committed (GR-10).

# local | test | production
ENVIRONMENT=local

# PostgreSQL container (deploy/docker-compose.yml)
POSTGRES_USER=munimailbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=munimailbox
POSTGRES_PORT=5432

# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://munimailbox:change-me@localhost:5432/munimailbox

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (shipped to Loki) | console (readable during development)
LOG_FORMAT=json

# Two different Fernet keys. Generate each with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY protects stored personal data: if it is lost, that data cannot be read again.
ENCRYPTION_KEY=
SESSION_SECRET=

# Dutch spaCy model used by Presidio for names and places
SPACY_MODEL=nl_core_news_lg

# The build fails if recall on the PII test set drops below this (GR-4)
PII_RECALL_THRESHOLD=0.95
# Originals and PII mappings are deleted this many days after an email arrived (GR-2)
PII_RETENTION_DAYS=30

# Local model, OpenAI-compatible API. Ollama: http://localhost:11434/v1
# Never put a hosted ("-cloud") model here: this route is trusted to stay on the machine.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# gemma3:4b writes better Dutch but needs 4-5 GB of RAM; on an 8 GB machine develop with
# gemma3:1b (about 1 GB) and use the larger model for an occasional quality check.
LOCAL_LLM_MODEL=gemma3:4b
# How many calls the local model server gets at once (chat and embeddings together).
LOCAL_LLM_MAX_CONCURRENCY=1

# Local embedding model for the knowledge base (multilingual; via the same local server)
EMBEDDING_MODEL=bge-m3

# ChromaDB container (deploy/docker-compose.yml)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Cloud fallback model (FR-13). Receives redacted text only. Off by default.
# Mistral processes data in the EU and speaks the same API format as the local server.
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.mistral.ai/v1
# On Mistral's free plan mistral-small and mistral-medium answer 429 (limit 0 per minute);
# open-mistral-nemo and ministral-8b-latest work there.
CLOUD_LLM_MODEL=mistral-small-latest
CLOUD_LLM_API_KEY=

# Simulated inbox written by scripts/generate_synthetic.py
FEED_PATH=data/synthetic/emails.jsonl
