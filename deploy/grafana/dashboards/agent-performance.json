{
  "uid": "munimailbox-agents",
  "title": "Agent performance",
  "tags": [
    "munimailbox"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "correlation_id",
        "label": "Correlation ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Median duration per agent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, agent) (rate(munimailbox_agent_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "title": "95th percentile duration per agent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(munimailbox_agent_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "title": "Retries per agent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent) (increase(munimailbox_agent_retries_total[5m]))",
          "legendFormat": "{{agent}}"
        }
      ],
      "id": 3
    },
    {
      "title": "Failures per agent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent) (increase(munimailbox_agent_failures_total[5m]))",
          "legendFormat": "{{agent}}"
        }
      ],
      "id": 4
    },
    {
      "title": "Tokens used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, kind) (increase(munimailbox_inference_tokens_total[5m]))",
          "legendFormat": "{{route}} {{kind}}"
        }
      ],
      "id": 5
    },
    {
      "title": "One email's journey (paste its correlation ID above)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"munimailbox\"} | json | correlation_id=\"$correlation_id\" | line_format \"{{.event}}  agent={{.agent}}  duration_ms={{.duration_ms}}  model={{.model}}  left_local={{.left_local}}\""
        }
      ],
      "description": "Every log line of one email, in order. The correlation ID is in the audit log's email link and in every log line.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending"
      },
      "id": 6
    }
  ]
}
