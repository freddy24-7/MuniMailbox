// Reads the app's JSON log file and sends each line to Loki (NFR-2).
//
// Only "level" and "event" become labels: both have a small, fixed set of values.
// The correlation ID stays inside the line. As a label it would create one stream per
// email; as a field it is found with:  {job="munimailbox"} | json | correlation_id="..."

local.file_match "app" {
  path_targets = [{"__path__" = "/var/log/munimailbox/*.log", "job" = "munimailbox"}]
}

loki.source.file "app" {
  targets    = local.file_match.app.targets
  forward_to = [loki.process.app.receiver]
}

loki.process "app" {
  stage.json {
    expressions = {level = "level", event = "event", timestamp = "timestamp"}
  }
  stage.labels {
    values = {level = "", event = ""}
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
