[Unit]
Description=Verify the audit hash chain (GR-8); fails if a record was changed
After=munimailbox.service

[Service]
Type=oneshot
User=munimailbox
Group=munimailbox
WorkingDirectory=/opt/munimailbox
EnvironmentFile=/etc/munimailbox/env
ExecStart=/opt/munimailbox/.venv/bin/python scripts/verify_audit.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
